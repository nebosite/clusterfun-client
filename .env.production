# Loaded automatically by `react-scripts build` (CRA reads .env.production for
# production builds).  The GA4 measurement ID itself stays out of git in
# src/secrets.ts - this file only decides that real telemetry is switched on,
# which is a fact about the build, not a secret.
#
# Set REACT_APP_NO_TELEMETRY=1 on a build command line to opt out.
REACT_APP_USE_REAL_TELEMETRY=1
